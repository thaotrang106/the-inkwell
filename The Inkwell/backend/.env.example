# ==============================================================================
# The Inkwell Bookstore - Backend Environment Configuration Template
# ==============================================================================

# PostgreSQL / Supabase connection string with pgvector extension enabled
# Format: postgresql+pg8000://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+pg8000://postgres:your_password@db.your-supabase-id.supabase.co:5432/postgres

# Google Gemini API Key (Gemini 2.5 Flash / text-embedding-004)
GEMINI_API_KEY=your_gemini_api_key_here
