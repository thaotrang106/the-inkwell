e UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;font color='#1D4ED8'&gt;0 × 0.5 = 0.0&lt;/font&gt;"><mxGeometry as="geometry" x="225" y="904" width="105" height="30" /></mxCell><mxCell id="td_6_3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=11;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="Rank #5"><mxGeometry as="geometry" x="330" y="904" width="75" height="30" /></mxCell><mxCell id="td_6_4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=11;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;font color='#047857'&gt;1 × 0.5 = 0.5&lt;/font&gt;"><mxGeometry as="geometry" x="405" y="904" width="105" height="30" /></mxCell><mxCell id="td_6_5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=11;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;font color='#64748B'&gt;0.5 đ&lt;/font&gt;"><mxGeometry as="geometry" x="510" y="904" width="100" height="30" /></mxCell><mxCell id="td_6_6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=11;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;font color='#64748B'&gt;Hạng 6&lt;/font&gt;"><mxGeometry as="geometry" x="610" y="904" width="90" height="30" /></mxCell><mxCell id="td_6_7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=11;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;font color='#64748B'&gt;Bị loại&lt;/font&gt;"><mxGeometry as="geometry" x="700" y="904" width="160" height="30" /></mxCell><mxCell id="tbl_note" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;align=left;spacingLeft=12;spacingRight=12;fontFamily=Segoe UI;" vertex="1" value="&lt;b&gt;• Quy tắc tính:&lt;/b&gt; Điểm nhánh = P - rank. Nếu sách không có trong top P đầu vào, điểm nhánh = 0.&lt;br&gt;&lt;b&gt;• Điểm Hybrid:&lt;/b&gt; 0.5 × Điểm CB + 0.5 × Điểm CF. Sắp xếp giảm dần theo điểm để chọn Top K = 4 cuốn xuất sắc nhất."><mxGeometry as="geometry" x="60" y="946" width="770" height="52" /></mxCell><mxCell id="ins_container" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" value=""><mxGeometry as="geometry" x="865" y="650" width="840" height="475" /></mxCell><mxCell id="ins_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontStyle=1;fontSize=14;fontColor=#B12704;" vertex="1" value="3 NGUYÊN LÝ KHOA HỌC THEN CHỐT CỦA THUẬT TOÁN BORDA COUNT FUSION"><mxGeometry as="geometry" x="880" y="662" width="810" height="24" /></mxCell><mxCell id="ins_p1" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;" vertex="1" value="&lt;b style='font-size:12.5px; color:#1E40AF;'&gt;1. Hiệu ứng cộng hưởng đồng thuận (Consensus Boosting)&lt;/b&gt;&lt;br&gt;&lt;font color='#1E293B' style='font-size:11px; line-height:1.35;'&gt;Các tác phẩm xuất hiện trong cả hai danh sách (A, B, C) nhận được điểm cộng dồn từ cả hai mô hình độc lập, tạo nên sức bật thứ hạng vượt trội và chiếm trọn 3 vị trí dẫn đầu (4.5đ, 4.0đ, 3.0đ). Điều này đảm bảo những tác phẩm vừa có cốt truyện tương đồng, vừa được bạn đọc cùng gu yêu thích luôn được ưu tiên đề xuất hàng đầu.&lt;/font&gt;"><mxGeometry as="geometry" x="880" y="694" width="810" height="118" /></mxCell><mxCell id="ins_p2" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#BBF7D0;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;" vertex="1" value="&lt;b style='font-size:12.5px; color:#15803D;'&gt;2. Bảo tồn tính đa dạng và khám phá mới (Serendipity Preservation)&lt;/b&gt;&lt;br&gt;&lt;font color='#1E293B' style='font-size:11px; line-height:1.35;'&gt;Sách F dù chỉ xuất hiện ở một nhánh duy nhất (Collaborative Filtering), nhưng nhờ có thứ hạng tốt (#3 với 3 điểm) nên điểm quy đổi Hybrid đạt 1.5 điểm, vượt qua sách D (chỉ 1.0 điểm) để giành suất vào Top 4. Cơ chế này chống lại hiện tượng rập khuôn (Over-specialization) của Content-Based, mang lại sự ngạc nhiên thú vị cho người đọc.&lt;/font&gt;"><mxGeometry as="geometry" x="880" y="822" width="810" height="118" /></mxCell><mxCell id="ins_p3" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF5F2;strokeColor=#FECDD3;strokeWidth=1.5;align=left;spacingLeft=14;spacingRight=14;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;" vertex="1" value="&lt;b style='font-size:12.5px; color:#991B1B;'&gt;3. Triệt tiêu hoàn toàn độ lệch thang đo (Scale Invariance)&lt;/b&gt;&lt;br&gt;&lt;font color='#1E293B' style='font-size:11px; line-height:1.35;'&gt;Khoảng cách Cosine trong pgvector dao động từ [0, 2], trong khi hệ số Ochiai dao động từ [0, 1]. Borda Count quy đổi thứ tự xếp hạng sang điểm số tương đối công bằng (P - Rank), loại bỏ hoàn toàn sự chênh lệch phân phối trước khi nhân trọng số cân bằng alpha (α = 0.5), giải quyết triệt để bài toán chuẩn hóa điểm không đồng nhất.&lt;/font&gt;"><mxGeometry as="geometry" x="880" y="950" width="810" height="122" /></mxCell></root></mxGraphModel></diagram></mxfile>