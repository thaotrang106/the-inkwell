<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="Borda_Count_Fusion_Diagram" name="Cơ chế Tổng hợp Borda Count Fusion"><mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="canvas_frame" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;shadow=0;" vertex="1" value=""><mxGeometry as="geometry" x="20" y="15" width="1710" height="1150" /></mxCell><mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontStyle=1;fontSize=23;fontColor=#1E3A8A;" vertex="1" value="SƠ ĐỒ CƠ CHẾ TỔNG HỢP ĐIỂM THEO THUẬT TOÁN HYBRID BORDA COUNT FUSION"><mxGeometry as="geometry" x="220" y="28" width="1310" height="35" /></mxCell><mxCell id="subtitle" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontStyle=2;fontSize=14;fontColor=#475569;" vertex="1" value="Minh họa quy tắc xếp hạng Borda Count với P = 5 ứng viên đầu vào, hệ số cân bằng α = 0.5 (Tác phẩm ký hiệu từ A đến G)"><mxGeometry as="geometry" x="320" y="64" width="1110" height="25" /></mxCell><mxCell id="kpi_borda" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=12;fontColor=#1E3A8A;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;b&gt;• Điểm nhánh Borda:&lt;/b&gt; Score = P - Rank (Hạng 1 = 5 điểm, Hạng 5 = 1 điểm)"><mxGeometry as="geometry" x="45" y="98" width="520" height="44" /></mxCell><mxCell id="kpi_hybrid" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF5F2;strokeColor=#B12704;strokeWidth=1.5;fontSize=12;fontColor=#B12704;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;b&gt;• Công thức Hybrid:&lt;/b&gt; Score_Hybrid = 0.5 × Score_CB + 0.5 × Score_CF"><mxGeometry as="geometry" x="585" y="98" width="540" height="44" /></mxCell><mxCell id="kpi_legend" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=12;fontColor=#065F46;fontFamily=Segoe UI;align=center;verticalAlign=middle;" vertex="1" value="&lt;b&gt;• Quy ước:&lt;/b&gt; Thẻ viền xanh/đậm là sách có mặt ở CẢ HAI danh sách (Giao thoa)"><mxGeometry as="geometry" x="1145" y="98" width="560" height="44" /></mxCell><mxCell id="hdr_cb" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;align=left;spacingLeft=15;fontFamily=Segoe UI;" vertex="1" value="&lt;b&gt;1. NHÁNH CONTENT-BASED (pgvector)&lt;/b&gt;&lt;br&gt;&lt;font color='#2563EB' size='2'&gt;Khoảng cách Cosine trên Vector 768 chiều (Score = P - Rank)&lt;/font&gt;"><mxGeometry as="geometry" x="55" y="158" width="480" height="54" /></mxCell><mxCell id="hdr_cf" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;align=left;spacingLeft=15;fontFamily=Segoe UI;" vertex="1" value="&lt;b&gt;2. NHÁNH COLLABORATIVE (Ochiai)&lt;/b&gt;&lt;br&gt;&lt;font color='#059669' size='2'&gt;Hệ số tương quan đồng xuất hiện cộng đồng (Score = P - Rank)&lt;/font&gt;"><mxGeometry as="geometry" x="625" y="158" width="480" height="54" /></mxCell><mxCell id="hdr_hb" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5F2;strokeColor=#B12704;strokeWidth=2;align=left;spacingLeft=15;fontFamily=Segoe UI;" vertex="1" value="&lt;b&gt;3. HYBRID RECOMMENDATION (TOP 4)&lt;/b&gt;&lt;br&gt;&lt;font color='#C2410C' size='2'&gt;Hợp nhất thứ hạng Borda Count cân bằng đa chiều (50/50)&lt;/font&gt;"><mxGeometry as="geometry" x="1195" y="158" width="480" height